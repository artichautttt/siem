# Copier ce fichier en ".env" et adapter les valeurs pour l'environnement local.

# Port d'écoute du serveur Flask
PORT=5000

# Chemin vers le fichier SQLite (par défaut : backend/siem.db)
DB_PATH=siem.db

# Origines autorisées pour CORS, séparées par des virgules
CORS_ORIGINS=http://localhost:4200

# Clé API exigée (header X-API-Key) pour les endpoints d'écriture.
# IMPORTANT : générer une valeur forte et unique en dehors de dev local,
# par ex. via `python -c "import secrets; print(secrets.token_hex(32))"`
API_KEY=change-me

# Active le mode debug Flask (auto-reload, tracebacks détaillées).
# Ne JAMAIS activer en production.
FLASK_DEBUG=False
