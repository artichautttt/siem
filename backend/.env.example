# Copier ce fichier en ".env" et adapter les valeurs pour l'environnement local.

# Port d'écoute du serveur Flask
PORT=5000

# Connexion PostgreSQL (nécessite une instance qui tourne : voir README pour
# la lancer avec Docker en local hors docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=minisiem
POSTGRES_USER=minisiem
POSTGRES_PASSWORD=minisiem

# Origines autorisées pour CORS, séparées par des virgules
CORS_ORIGINS=http://localhost:4200

# Clé API exigée (header X-API-Key) pour les endpoints d'écriture.
# IMPORTANT : générer une valeur forte et unique en dehors de dev local,
# par ex. via `python -c "import secrets; print(secrets.token_hex(32))"`
API_KEY=change-me

# Active le mode debug Flask (auto-reload, tracebacks détaillées).
# Ne JAMAIS activer en production.
FLASK_DEBUG=False

# Intégration Wazuh (optionnelle) : instance déployée séparément
# (voir wazuh-docker/single-node), non gérée par ce docker-compose.
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_USER=admin
WAZUH_PASSWORD=SecretPassword
WAZUH_VERIFY_SSL=False
