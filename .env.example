# Copier ce fichier en ".env" (à la racine du projet, à côté de docker-compose.yml)
# pour piloter les variables lues par Docker Compose. Ce fichier est distinct de
# backend/.env, qui n'est utilisé que pour un lancement du backend hors Docker.

# PostgreSQL — utilisé par le service "postgres" ET par le backend pour s'y
# connecter (POSTGRES_HOST=postgres est fixé directement dans docker-compose.yml).
# IMPORTANT : changer POSTGRES_PASSWORD avant tout usage partagé.
POSTGRES_DB=minisiem
POSTGRES_USER=minisiem
POSTGRES_PASSWORD=minisiem

# Origines autorisées pour CORS, séparées par des virgules
CORS_ORIGINS=http://localhost:4200

# Authentification JWT multi-rôle (remplace l'ancienne clé API unique).
# IMPORTANT : générer des valeurs fortes et uniques en dehors de dev local,
# par ex. via `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=change-me-jwt-secret
# Compte admin créé automatiquement au premier démarrage (table users vide).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Active le mode debug Flask (auto-reload, tracebacks détaillées).
# Ne JAMAIS activer en production.
FLASK_DEBUG=False

# Intégration Wazuh (optionnelle) : instance déployée séparément
# (voir wazuh-docker/single-node), non gérée par ce docker-compose.
# host.docker.internal permet au conteneur backend de joindre l'hôte.
WAZUH_INDEXER_URL=https://host.docker.internal:9200
WAZUH_USER=admin
WAZUH_PASSWORD=SecretPassword
WAZUH_VERIFY_SSL=False
